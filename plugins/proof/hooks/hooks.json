{
  "description": "proof: after a context summary, make the agent read the pstack hub again before it edits. Fails open on any fault.",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/hooks/proof_hook.py\" precompact || python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/proof_hook.py\" precompact",
            "commandWindows": "python -I -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','proof_hook.py'),run_name='__main__')\" precompact",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/hooks/proof_hook.py\" session-start || python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/proof_hook.py\" session-start",
            "commandWindows": "python -I -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','proof_hook.py'),run_name='__main__')\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|apply_patch|Bash|PowerShell|exec_command|shell|shell_command|local_shell|unified_exec|mcp__.*([Ww]rite|[Ee]dit|[Cc]reate|[Mm]ove|[Dd]elete|[Pp]atch|[Rr]ename|[Rr]emove).*",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/hooks/proof_hook.py\" gate || python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/proof_hook.py\" gate",
            "commandWindows": "python -I -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','proof_hook.py'),run_name='__main__')\" gate",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Bash|PowerShell|exec_command|shell|shell_command|local_shell|unified_exec",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"${CLAUDE_PLUGIN_ROOT}/hooks/proof_hook.py\" release || python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/proof_hook.py\" release",
            "commandWindows": "python -I -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','proof_hook.py'),run_name='__main__')\" release",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
